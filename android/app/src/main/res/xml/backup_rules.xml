<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules for Android 11 and below. Mirrors
  res/xml/data_extraction_rules.xml: nothing on this device (token, PIN
  credential, cached memory data) is allowed into any backup artifact.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
